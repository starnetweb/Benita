# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# WordPress Site
WP_SITE_URL=https://yoursite.com/blog/
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WP_DEFAULT_CATEGORY_ID=1
WP_DEFAULT_AUTHOR_ID=1

# WordPress Post Settings
WP_POST_STATUS=draft

# OpenRouter (LLM text rewriting)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=anthropic/claude-opus-4

# Image Generation
# Set IMAGE_PROVIDER to one of: openai | google | fal | pollinations
IMAGE_PROVIDER=openai

# OpenAI DALL-E / gpt-image-1
OPENAI_API_KEY=your_openai_api_key_here
IMAGE_MODEL_OPENAI=gpt-image-1

# Google Imagen
GOOGLE_API_KEY=your_google_api_key_here
IMAGE_MODEL_GOOGLE=imagen-4.0-generate-001

# Fal.ai
FAL_API_KEY=your_fal_api_key_here
IMAGE_MODEL_FAL=fal-ai/flux-pro/v1.1

# Google News / SerpAPI (optional)
SERPAPI_KEY=

# Twitter/X API (optional)
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Agent Settings
MAX_POSTS_PER_RUN=5
MIN_WORD_COUNT=320
NEWS_LOOKBACK_HOURS=168
AGENT_TIMEZONE=Africa/Lagos

# Database & Logs (Docker uses /app/db and /app/logs)
DB_PATH=/app/db/blogger.db
LOG_PATH=/app/logs/agent.log
